# QS backend settings. Copy to .env for local runs; set the same names in Vercel project settings.
# Never commit real values: this repository is public.

# Supabase project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=
# Publishable key (sb_publishable_...; legacy projects: the anon key). Safe for browsers.
SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...; legacy: service_role). SERVER ONLY. Bypasses row-level security.
# Never put it in Unity, the frontend, or any VITE_ variable.
SUPABASE_SECRET_KEY=
# Only for projects still on the legacy symmetric JWT secret. New projects use JWKS and leave this empty.
SUPABASE_JWT_SECRET=

# Gemini summary (optional: the service works without it).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
QS_GEMINI_DISABLED=0

# Comma-separated origins allowed to call the API from a browser, e.g. https://your-site.vercel.app
QS_CORS_ORIGINS=

# "supabase" (default) or "memory" (in-process store for local experiments; data vanishes on restart).
QS_STORE=supabase
