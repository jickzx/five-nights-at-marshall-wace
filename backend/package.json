{
  "name": "fnmw-voice-backend",
  "private": true,
  "version": "0.1.0",
  "description": "Server-side proxy for the game's optional OpenRouter dialogue/hints and ElevenLabs speech. Keys stay here.",
  "type": "module",
  "engines": { "node": ">=22.18" },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/main.ts",
    "dev": "FNMW_PROVIDER_MODE=mock node --env-file-if-exists=.env src/main.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test --test-reporter=spec test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.8.3"
  }
}
