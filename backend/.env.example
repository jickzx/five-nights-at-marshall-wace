# Copy to backend/.env (git-ignored) and fill in. Never commit real values.
# live (default) uses the provider keys below; a feature with no key or voice id is reported off.
# mock needs no keys: canned lines and a beeping placeholder tone, labelled MOCK everywhere.
FNMW_PROVIDER_MODE=mock
FNMW_BIND=127.0.0.1:8787
# Game token(s) the Unity client sends to open a session (comma-separated, 16+ characters each).
# Generate one with: openssl rand -hex 24   and put the same value in Unity/UserSettings/fnmw-voice.json
FNMW_GAME_TOKENS=
# Required in live mode, at least 32 bytes: openssl rand -hex 32
FNMW_SESSION_SECRET=

# Provider keys stay in local configuration. Requests allow only free text models.
OPENROUTER_API_KEY=
# ElevenLabs speech still needs its own key and voice ids.
ELEVENLABS_API_KEY=
FNMW_OPENROUTER_MODEL=openrouter/free
FNMW_TTS_MODEL=eleven_flash_v2_5

# Voice ids your ElevenLabs account may use through the API (original, Voice Design or licensed library voices).
# Never a clone of a real person. Optional per-language native overrides: FNMW_VOICE_NATIVE_JA, _FR, _ES, _DE, _TR, _ZH, _AR
FNMW_VOICE_MONSTER=
FNMW_VOICE_SHIP=
FNMW_VOICE_NATIVE=

# Optional limit overrides (defaults in src/config.ts)
# FNMW_DAILY_OPENROUTER_CALLS=2000
# FNMW_DAILY_SPEECH_CHARS=60000
# FNMW_SESSION_SPEECH_CHARS=8000
# FNMW_SESSIONS_PER_IP=3
# FNMW_REQUESTS_PER_IP=120
# Mock mode only: simulate provider trouble (timeout | 429 | 500 | garbage)
# FNMW_MOCK_FAULT=none
