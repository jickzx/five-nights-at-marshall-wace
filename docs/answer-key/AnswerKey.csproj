<Project Sdk="Microsoft.NET.Sdk">
  <!-- Prints the puzzle answer key for any seed by compiling the game's own language engine
       (Unity/Assets/Scripts/Lang + two Core files) outside Unity. Read-only: it changes nothing in the game. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>answer-key</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="../../Unity/Assets/Scripts/Core/LanguageTypes.cs" />
    <Compile Include="../../Unity/Assets/Scripts/Core/LangConcepts.cs" />
    <Compile Include="../../Unity/Assets/Scripts/Lang/LanguageEngine.cs" />
    <Compile Include="../../Unity/Assets/Scripts/Lang/Feedback.cs" />
    <Compile Include="../../Unity/Assets/Scripts/Lang/Framework/*.cs" />
    <Compile Include="../../Unity/Assets/Scripts/Lang/Languages/*.cs" />
  </ItemGroup>
</Project>
