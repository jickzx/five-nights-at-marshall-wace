# Frontend settings for the QS Data Pipeline page (/qs/). Vite exposes VITE_* variables to the browser,
# so ONLY public values go here: the API URL, the Supabase project URL and its publishable (anon) key.
# Never the Supabase secret/service_role key or the Gemini key. With no API URL the page runs in demo mode.
VITE_QS_API_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
